# ==============================================================================
# KhelNiti configuration template. Copy to .env and fill in real values.
# NEVER commit a real .env file. Only this .env.example belongs in git.
# ==============================================================================

# --- Application ---
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-64-char-value
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://khelniti:khelniti@localhost:5432/khelniti
DATABASE_URL_TEST=postgresql+psycopg2://khelniti:khelniti@localhost:5432/khelniti_test

# --- Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
API_RATE_LIMIT_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Data Providers ---
# Provider abstraction interfaces live in data/ingestion/providers.
# DATA_PROVIDER_MODE selects which implementation is wired up at runtime.
# "mock" uses synthetic, clearly-labeled development data (default, no key required).
# "live" requires the real credentials below and a provider implementation
# registered against the CricketDataProvider / FootballDataProvider interface.
DATA_PROVIDER_MODE=mock

# Cricket data provider (e.g. a licensed ball-by-ball data vendor)
CRICKET_DATA_PROVIDER=
CRICKET_DATA_API_KEY=
CRICKET_DATA_BASE_URL=

# Football data provider (e.g. a licensed fixtures/events data vendor)
FOOTBALL_DATA_PROVIDER=
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=

# News provider
NEWS_DATA_PROVIDER=
NEWS_DATA_API_KEY=

# Weather / context provider
WEATHER_DATA_PROVIDER=
WEATHER_DATA_API_KEY=

# Market / odds provider — only enable if you hold a valid data license for
# your jurisdiction. Leave blank to keep market intelligence disabled.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# --- WebSocket / Live Engine ---
WEBSOCKET_PATH=/ws/live
LIVE_EVENT_QUEUE_URL=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
